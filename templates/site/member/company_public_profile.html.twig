{% extends 'layouts/member_company.html.twig' %}
{% form_theme form 'form_themes/tailwind.html.twig' %}

{% block title %}Profil public - AFUP{% endblock %}

{% block page_body %}

    <div class="container mx-auto flex flex-col px-4 py-6 gap-6 sm:px-28 sm:py-10 sm:gap-10">

        <h1 class="font-titre text-afup-800 text-2xl sm:text-4xl">Profil public</h1>

        {{ form_start(form) }}

        <twig:Card class="flex flex-col gap-8 px-6 py-8 sm:px-10 sm:py-10">
            {{ form_errors(form) }}

            <twig:Card:Section title="Profil public : {{ company_member.companyName }}">
                {{ form_row(form.enabled) }}

                {% if company_member.publicProfileEnabled %}
                    <p>
                        <a href="{{ path('company_public_profile', {id: company_member.id, slug: company_member.slug}) }}"
                           class="text-afup-500 underline hover:no-underline">Voir mon profil public</a>
                    </p>
                {% endif %}

                {{ form_row(form.description) }}
                {{ form_row(form.logo) }}

                {% if company_member.logoUrl %}
                    <img src="{{ path('company_public_profile_logo', {id : company_member.id, slug: company_member.slug }) }}"
                         alt="" class="max-w-50 h-auto" />
                {% endif %}

                {{ form_row(form.website_url) }}
                {{ form_row(form.careers_page_url) }}
                {{ form_row(form.contact_page_url) }}
                {{ form_row(form.twitter_handle) }}
                {{ form_row(form.related_afup_offices) }}
                {{ form_row(form.membership_reason) }}
            </twig:Card:Section>

            <div class="flex flex-col-reverse sm:flex-row items-center justify-between gap-4 border-t-2 border-neutre-300 pt-5">
                <p class="text-sm text-neutre-400">*&nbsp;Indique un champ obligatoire</p>
                {{ form_widget(form.submit) }}
            </div>
        </twig:Card>

        {{ form_end(form) }}

    </div>

{% endblock %}
