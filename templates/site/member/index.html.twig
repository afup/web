{% extends 'layouts/member.html.twig' %}

{% block title %}Espace membre - AFUP{% endblock %}

{% block page_body %}

    <div class="container mx-auto flex flex-col px-4 py-6 gap-6 sm:px-28 sm:py-10 sm:gap-10">

        <h1 class="font-titre text-afup-800 text-2xl sm:text-4xl">Espace membre</h1>

        {% if display_link_to_general_meeting_vote %}
            <twig:Button as="a" variant="primary" class="flex self-start px-8 py-3 text-xl"
                         href="{{ path('member_general_meeting') }}">Voter lors de l'assemblée générale</twig:Button>
        {% endif %}

        <section class="flex flex-col gap-4">
            <twig:SectionTitle>Mon compte</twig:SectionTitle>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8">

                <twig:Card class="flex flex-col gap-3">
                    <p class="text-afup-800"><span class="font-semibold">Mes coordonnées</span> : {{ user.label }}</p>
                    <p class="text-sm text-neutre-700 grow">Modifiez votre adresse de facturation et votre adresse email, changez votre mot de passe</p>
                    <twig:Button as="a" variant="secondary" class="flex self-start"
                                 href="{{ path('member_contact') }}" title="Modifier les coordonnées">Modifier</twig:Button>
                </twig:Card>

                <twig:Card class="flex flex-col gap-3">
                    <p class="text-afup-800">
                        <span class="font-semibold">Cotisations</span>
                        {% if membershipfee_end_date %}
                            : <span class="{% if membership_fee_call_to_update %}font-bold text-ruby-500{% endif %}">
                                {% if has_up_to_date_membership_fee %}expire le{% else %}a expirée le{% endif %}
                                {{ membershipfee_end_date|date('d/m/Y') }}
                            </span>
                        {% endif %}
                    </p>
                    <p class="text-sm text-neutre-700 grow">Renouvelez votre adhésion, retrouvez l’historique de vos cotisations, téléchargez vos factures.</p>
                    <twig:Button as="a" class="flex self-start" href="{{ path('member_membership_fee') }}"
                                 variant="{{ has_up_to_date_membership_fee ? 'secondary' : 'primary' }}">{% if has_up_to_date_membership_fee %}Consulter{% else %}Se mettre à jour{% endif %}</twig:Button>
                </twig:Card>

                <twig:Card class="flex flex-col gap-3">
                    <p class="text-afup-800"><span class="font-semibold">Veille de l'AFUP</span> : {% if has_member_subscribed_to_techletter %}inscrit(e){% else %}non inscrit{% endif %}</p>
                    <p class="text-sm text-neutre-700 grow">Profitez de cet avantage exclusif réservé à nos membres : recevez 2 fois par mois notre veille dédiée à PHP, effectuée par notre pôle d’expert·e·s.</p>
                    <twig:Button as="a" class="flex self-start" href="{{ path('member_techletter') }}"
                                 variant="{{ has_member_subscribed_to_techletter ? 'secondary' : 'primary' }}">{% if has_member_subscribed_to_techletter %}Consulter{% else %}Gérer mon abonnement{% endif %}</twig:Button>
                </twig:Card>

                <twig:Card class="flex flex-col gap-3">
                    <p class="text-afup-800"><span class="font-semibold">Assemblée générale</span></p>
                    <p class="text-sm text-neutre-700 grow">L’AG annuelle de l’association se tient chaque mois de février. Le moment venu, indiquez votre présence ou donnez votre pouvoir à un·e autre membre.</p>
                    {% if has_general_meeting_planned %}
                        <twig:Button as="a" class="flex self-start" href="{{ path('member_general_meeting') }}"
                                     variant="{{ has_user_rspved_to_next_general_meeting ? 'secondary' : 'primary' }}">Indiquer ma présence</twig:Button>
                    {% else %}
                        <twig:Button as="a" variant="secondary" class="flex self-start"
                                     href="{{ path('member_general_meeting') }}">Comptes-rendus</twig:Button>
                    {% endif %}
                </twig:Card>

                <twig:Card class="flex flex-col gap-3">
                    <p class="text-afup-800"><span class="font-semibold">Antenne la plus proche</span> : {% if office_label %}{{ office_label }}{% else %}Aucune{% endif %}</p>
                    <p class="text-sm text-neutre-700 grow">Indiquez l’antenne AFUP la plus proche de chez vous : une information qui sera notamment utile pour votre badge lors du Forum PHP !</p>
                    <twig:Button as="a" class="flex self-start" href="{{ path('member_contact') }}"
                                 variant="{{ office_label ? 'secondary' : 'primary' }}">{% if office_label %}Modifier{% else %}Définir{% endif %}</twig:Button>
                </twig:Card>

                {% if user.canRequestSlackInvite or user.slackInviteRequested %}
                    <twig:Card class="flex flex-col gap-3">
                        <p class="text-afup-800"><span class="font-semibold">Slack membres AFUP</span></p>
                        <p class="text-sm text-neutre-700 grow">Rejoignez notre Slack réservé à nos membres, pour discuter PHP, poster vos recherches d’emploi et profiter d’un espace privilégié pour échanger avec la communauté.</p>
                        {% if user.canRequestSlackInvite %}
                            <twig:Button as="a" variant="primary" class="flex self-start"
                                         href="{{ path('member_slack_invite') }}">Recevoir l'invitation</twig:Button>
                        {% elseif user.slackInviteRequested %}
                            <twig:Button as="a" variant="secondary" class="flex self-start"
                                         href="https://afup-membres.slack.com/" target="afup-slack">Accéder</twig:Button>
                        {% endif %}
                    </twig:Card>
                {% endif %}

            </div>
        </section>

        {% if is_granted('ROLE_COMPANY_MANAGER') %}
            <section class="flex flex-col gap-4">
                <twig:SectionTitle>Mon compte société</twig:SectionTitle>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-8">
                    <twig:Card class="flex flex-col gap-3">
                        <p class="text-afup-800 font-semibold grow">Coordonnées</p>
                        <twig:Button as="a" variant="secondary" class="flex self-start"
                                     href="{{ path('member_company') }}" title="Modifier les coordonnées">Modifier</twig:Button>
                    </twig:Card>

                    <twig:Card class="flex flex-col gap-3">
                        <p class="text-afup-800 font-semibold grow">Personnes rattachées</p>
                        <twig:Button as="a" variant="secondary" class="flex self-start"
                                     href="{{ path('member_company_members') }}" title="Modifier les personnes rattachées">Modifier</twig:Button>
                    </twig:Card>

                    <twig:Card class="flex flex-col gap-3">
                        <p class="text-afup-800 font-semibold grow">Profil public</p>
                        <twig:Button as="a" variant="secondary" class="flex self-start"
                                     href="{{ path('member_company_public_profile') }}" title="Modifier le profil public">Modifier</twig:Button>
                    </twig:Card>
                </div>
            </section>
        {% endif %}

        <section class="flex flex-col gap-4">
            <twig:SectionTitle>Restons en contact</twig:SectionTitle>

            <p class="text-neutre-700">Plusieurs façons de rester au fait des activités de l’association et ainsi, de profiter au mieux de votre adhésion :</p>
            <ul class="list-disc pl-5 text-neutre-700 flex flex-col gap-1">
                <li>La newsletter des activités de l’AFUP sort le premier mardi de chaque mois. Assurez-vous qu’elle ne parte pas dans vos spams ;</li>
                <li>Visitez régulièrement <a href="{{ path('home') }}" class="text-afup-500 underline hover:no-underline">notre site</a> ou vous abonner à <a href="{{ path('feed_rss') }}" class="text-afup-500 underline hover:no-underline">nos flux RSS</a> ;</li>
                <li>Nous suivre sur les réseaux sociaux <a href="https://twitter.com/afup" class="text-afup-500 underline hover:no-underline">Twitter</a> et/ou <a href="https://mastodon.online/@afup" class="text-afup-500 underline hover:no-underline">Mastodon</a> ;</li>
                <li>Consulter la <a href="{{ path('offices') }}" class="text-afup-500 underline hover:no-underline">liste des antennes</a> afin de suivre leur activité.</li>
            </ul>
        </section>

        {% if badges %}
            <section class="flex flex-col gap-4">
                <twig:SectionTitle>Badges</twig:SectionTitle>
                <div class="flex flex-row flex-wrap gap-4">
                    {% for badge in badges %}
                        {% if badge.id is defined %}
                            <img title="{{ badge.tooltip }}" src="{{ path('badge_image', {id: badge.id}) }}" alt="Badge" class="size-24 object-contain" />
                        {% else %}
                            <img title="{{ badge.tooltip }}" src="/images/badges/{{ badge.code }}.png" alt="Badge {{ badge.code }}" class="size-24 object-contain" />
                        {% endif %}
                    {% endfor %}
                </div>
            </section>
        {% endif %}

    </div>

{% endblock %}
