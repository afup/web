{% extends 'layouts/member.html.twig' %}

{% block title %}Veille de l'AFUP - Espace membre{% endblock %}

{% block page_body %}

    <div class="container mx-auto flex flex-col px-4 py-6 gap-6 sm:px-28 sm:py-10 sm:gap-10">

        <div class="flex flex-col gap-5">
            <h1 class="font-titre text-afup-800 text-2xl sm:text-4xl">Veille de l'AFUP</h1>
            <p class="text-neutre-700">
                Pour plus d'informations sur la veille de l'AFUP, consultez
                <a href="{{ path('techletter') }}" class="text-afup-500 underline hover:no-underline">cette page</a>.
            </p>
        </div>

        {% if not feeUpToDate %}
            <twig:Alert type="error" class="flex flex-col gap-3">
                <p>Vous n'êtes pas à jour de votre cotisation.</p>
                <p>Vous ne pourrez donc pas recevoir, vous inscrire ni consulter l'historique des veilles de l'AFUP.</p>
                <p>
                    Vous pouvez dès à présent régler votre cotisation via
                    <a href="{{ path('member_membership_fee') }}" class="underline hover:no-underline">Cotisations</a>.
                </p>
            </twig:Alert>
        {% else %}
            <twig:Card class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-8">
                {% if subscribed %}
                    <p class="text-neutre-700 grow">Vous recevez actuellement la veille de l'AFUP deux fois par mois sur l'adresse {{ app.user.email }}.</p>
                    <twig:Button as="a" variant="secondary" class="flex shrink-0 px-8 py-3 text-base"
                                 href="{{ path('member_techletter_unsubscribe') }}">Me désabonner</twig:Button>
                {% else %}
                    <p class="text-neutre-700 grow">Vous ne recevez actuellement pas la veille de l'AFUP.</p>
                    <form method="post" action="{{ path('member_techletter_subscribe') }}" class="shrink-0">
                        <input type="hidden" name="_csrf_token" value="{{ token }}" />
                        <twig:Button variant="primary" type="submit" class="flex px-8 py-3 text-base">M'abonner</twig:Button>
                    </form>
                {% endif %}
            </twig:Card>

            <section class="flex flex-col gap-4">
                <twig:SectionTitle>Historique des veilles</twig:SectionTitle>

                <div class="flex flex-col divide-y divide-neutre-300">
                    {% for envoi in techletter_history %}
                        <div class="flex flex-col sm:flex-row sm:items-center gap-3 py-3 first:pt-0">
                            <span class="text-neutre-700 grow">Veille du {{ envoi.dateEnvoi|date('d/m/Y') }}</span>
                            {# urlArchive peut être nul : le composant Button refuse un href null. #}
                            {% if envoi.urlArchive %}
                                <twig:Button as="a" variant="secondary" class="flex self-start shrink-0"
                                             target="afup-veille" href="{{ envoi.urlArchive }}">Consulter</twig:Button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

    </div>

{% endblock %}
