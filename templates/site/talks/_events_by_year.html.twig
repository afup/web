{# Éditions groupées par année : navigation par année puis une section par année, chaque édition liée à sa page.
   `heading_level` : niveau des titres d'année (2 par défaut, 3 sous un titre de section). #}
{% set heading_tag = 'h' ~ (heading_level|default(2)) %}
<div class="flex flex-col gap-8">
    {% if summaries_by_year|length > 1 %}
        <nav aria-label="Années">
            <ul class="flex flex-wrap gap-2">
                {% for year in summaries_by_year|keys %}
                    <li>
                        <a href="#evenements-{{ year }}"
                           class="inline-flex items-center justify-center rounded-lg bg-afup-100 px-2 py-1 text-sm font-medium text-afup-500 hover:bg-afup-500 hover:text-white">{{ year }}</a>
                    </li>
                {% endfor %}
            </ul>
        </nav>
    {% endif %}

    {% for year, summaries in summaries_by_year %}
        <section id="evenements-{{ year }}" class="flex flex-col gap-4 scroll-mt-4">
            {# Mêmes classes que le composant SectionTitle, qui ne rend qu'un h2 #}
            <{{ heading_tag }} class="font-semibold text-base text-afup-800 border-b border-neutre-300 pb-2">{{ year }}</{{ heading_tag }}>
            <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                {% for summary in summaries %}
                    <li class="flex flex-col gap-1 rounded-2xl border-2 border-neutre-300 p-4">
                        <a href="{{ path('talks_event', {path: summary.event.path}) }}"
                           class="font-titre text-lg leading-snug text-afup-800 hover:underline">{{ summary.event.title }}</a>
                        <p class="text-sm text-neutre-400">
                            {{ summary.talkCount }} talk{{ summary.talkCount > 1 ? 's' }}
                            · {{ summary.videoCount }} vidéo{{ summary.videoCount > 1 ? 's' }}
                        </p>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% else %}
        <p class="text-neutre-700">Aucun événement pour le moment.</p>
    {% endfor %}
</div>
