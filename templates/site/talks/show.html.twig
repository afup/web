{% extends 'layouts/site.html.twig' %}

{% set breadcrumb = [
    { name: 'Accueil', url: url('home') },
    { name: 'Conférences', url: url('talks_list') },
    { name: event.title, url: talks_event_url(event) },
    { name: talk.title, url: url('talks_show', {id: talk.id, slug: talk.slug}) },
] %}

{% block title %}{{ talk.title }} - {{ event.title }}{% endblock %}

{% block metas %}
    {{ parent() }}
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="{{ talk.title }}">
    <meta name="twitter:description" content="{{ talk.description|striptags|raw }}">
    {% if talk.hasYoutubeId %}
        <meta name="twitter:image:src" content="https://img.youtube.com/vi/{{ talk.getYoutubeId }}/hqdefault.jpg">
    {% endif %}
    <meta name="twitter:domain" content="afup.org">

    <meta property="og:title" content="{{ talk.title }}" />
    <meta property="og:url" content="{{ url('talks_show', {id: talk.id, slug: talk.slug }) }}" />
    {% if talk.hasYoutubeId %}
        <meta property="og:image" content="https://img.youtube.com/vi/{{ talk.getYoutubeId }}/hqdefault.jpg" />
        <meta property="og:type" content="video.other" />
        <script type="application/ld+json">
            {{ {
                '@context': 'https://schema.org',
                '@type': 'VideoObject',
                name: talk.title,
                description: talk.description|striptags|trim,
                thumbnailUrl: ['https://img.youtube.com/vi/' ~ talk.youtubeId ~ '/hqdefault.jpg'],
                uploadDate: (event.dateEnd ?? event.dateStart)|date('c'),
                embedUrl: 'https://www.youtube.com/embed/' ~ talk.youtubeId,
                url: url('talks_show', {id: talk.id, slug: talk.slug}),
            }|json_encode|raw }}
        </script>
    {% else %}
        <meta property="og:type" content="article" />
    {% endif %}
    <meta property="og:description" content="{{ talk.description|striptags|raw }}" />
    <meta property="og:site_name" content="AFUP" />

    <script type="application/ld+json">
        {{ {
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            itemListElement: breadcrumb|map((item, index) => {
                '@type': 'ListItem',
                position: index + 1,
                name: item.name,
                item: item.url,
            }),
        }|json_encode|raw }}
    </script>
{% endblock %}

{% block content %}

    {% set event_date %}
        {% if event.dateStart == event.dateEnd %}le {{ event.dateStart|date('d') }}{% else %}les {{ event.dateStart|date('d') }} et {{ event.dateEnd|date('d') }}{% endif %} {{ event.dateEnd|format_date('none', 'MMMM YYYY') }}
    {% endset %}
    {% set event_url = talks_event_url(event) %}
    {% set speakers_label = speakers|map(speaker => speaker.label)|join(', ') %}

    <nav aria-label="Fil d'Ariane" class="container mx-auto px-4 py-3 sm:px-28 text-sm text-neutre-400">
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
            {% for item in breadcrumb %}
                <li class="flex items-center gap-2 min-w-0">
                    {% if loop.last %}
                        <span aria-current="page" class="text-neutre-700">{{ item.name }}</span>
                    {% else %}
                        <a href="{{ item.url }}" class="text-afup-500 underline hover:no-underline">{{ item.name }}</a>
                        <span aria-hidden="true">›</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>

    {% if talk.hasYoutubeId %}
        {# Scène sombre : le bandeau n'annonce pas la page, il détache le lecteur du fond. #}
        <div class="bg-afup-900">
            <div class="container mx-auto px-4 py-10 sm:px-28 sm:py-14 flex flex-col gap-8">
                <div class="flex flex-col gap-2">
                    <p class="text-sm text-white/70">
                        <a href="{{ event_url }}" class="underline hover:no-underline">{{ event.title }}</a> · {{ event_date|trim }}
                    </p>
                    <h1 class="font-titre text-2xl sm:text-4xl leading-tight text-white">{{ talk.title }}</h1>
                    <p class="text-white/90">{{ speakers_label }}</p>
                </div>

                <div class="w-full aspect-video rounded-2xl overflow-hidden bg-black">
                    <div id="player" class="w-full h-full">
                        <iframe src="https://www.youtube.com/embed/{{ talk.youtubeId }}"
                                title="{{ talk.title }}"
                                class="w-full h-full"
                                frameborder="0"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                    </div>
                </div>
            </div>
        </div>
    {% else %}
        <div class="container mx-auto px-4 py-6 sm:px-28 sm:py-10 flex flex-col gap-2">
            <p class="text-sm text-neutre-400">
                <a href="{{ event_url }}" class="text-afup-500 underline hover:no-underline">{{ event.title }}</a> · {{ event_date|trim }}
            </p>
            <h1 class="font-titre text-2xl sm:text-4xl leading-tight text-afup-800">{{ talk.title }}</h1>
            <p class="text-neutre-700">{{ speakers_label }}</p>
        </div>
    {% endif %}

    <div class="container mx-auto px-4 py-6 sm:px-28 sm:py-10 flex flex-col-reverse sm:flex-row gap-8 items-start">

        <div class="flex flex-col gap-10 grow w-full min-w-0">

            <section class="flex flex-col gap-4">
                <twig:SectionTitle>À propos</twig:SectionTitle>
                <div class="prose max-w-none">
                    {% if talk.useMarkdown %}
                        {{ talk.abstract|raw|markdown }}
                    {% else %}
                        {{ talk.abstract|raw }}
                    {% endif %}
                </div>
            </section>

            <section class="flex flex-col gap-4">
                <twig:SectionTitle>{{ speakers|length > 1 ? 'Les speakers' : 'Le speaker' }}</twig:SectionTitle>

                {% for speaker in speakers %}
                    <div class="flex flex-col sm:flex-row gap-5">
                        {# La photo est facultative : elle ne doit pas laisser de colonne vide quand elle manque. #}
                        {% if photo_storage.getUrl(speaker) %}
                            <img src="{{ photo_storage.getUrl(speaker) }}" alt=""
                                 class="size-24 shrink-0 rounded-2xl object-cover bg-neutre-200" />
                        {% endif %}
                        <div class="flex flex-col items-start gap-2 grow min-w-0">
                            <div class="flex items-center gap-2">
                                <h3 class="font-titre font-bold text-lg text-afup-800">{{ speaker.label }}</h3>
                                {% if speaker.twitter %}
                                    <a href="https://twitter.com/{{ speaker.twitter }}"
                                       aria-label="{{ speaker.label }} sur Twitter"
                                       class="text-neutre-400 hover:text-afup-500">
                                        <twig:ux:icon name="fa:twitter" class="size-5" />
                                    </a>
                                {% endif %}
                            </div>
                            <p class="text-neutre-700">{{ speaker.biography }}</p>
                            <a href="{{ url('talks_list', {"fR": { "speakers.label" : [ speaker.label ]}}) }}"
                               class="text-sm text-afup-500 underline hover:no-underline">Voir tous ses talks</a>
                        </div>
                    </div>
                {% endfor %}
            </section>

            {% if comments|filter(comment => comment.comment|length)|length %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Commentaires</twig:SectionTitle>
                    {% for comment in comments|filter(comment => comment.comment|length) %}
                        <twig:Card class="flex flex-col gap-3">
                            <p class="text-neutre-700">{{ comment.comment }}</p>
                            <div class="flex flex-wrap items-center gap-3 border-t border-neutre-300 pt-3">
                                <div class="flex items-center gap-0.5" aria-label="Note : {{ comment.rating }} sur 5">
                                    {% for i in 1..5 %}
                                        <twig:ux:icon name="mingcute:star-fill"
                                                      class="size-4 {{ comment.rating >= i ? 'text-afup-300' : 'text-neutre-300' }}" />
                                    {% endfor %}
                                </div>
                                <p class="text-sm text-neutre-400">
                                    {{ comment.user_display_name }}, le {{ comment.created_date|date('d/m/Y') }}
                                </p>
                            </div>
                        </twig:Card>
                    {% endfor %}
                </section>
            {% endif %}

            {% if transcript %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Transcription de la vidéo</twig:SectionTitle>
                    <div class="transcript flex flex-col gap-2 border-l-4 border-afup-300 pl-4">
                        {% for cue in transcript %}
                            <p data-cue-start="{{ cue.start }}"
                               class="text-neutre-700 {% if talk.hasYoutubeId %}cursor-pointer hover:text-afup-500{% endif %}">{{ cue.text }}</p>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {% if talk.verbatim %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Verbatim</twig:SectionTitle>
                    <div class="prose max-w-none">{{ talk.verbatim|markdown }}</div>
                </section>
            {% endif %}

        </div>

        <div class="w-full sm:w-72 sm:shrink-0">
            <twig:Card class="flex flex-col gap-5">
                {% set links = [
                    { shown: talk.hasSlidesUrl,        url: talk.getSlidesurl,      icon: 'mingcute:presentation-1-fill', label: 'Slides' },
                    { shown: talk.hasBlogPostUrl,      url: talk.getBlogPostUrl,    icon: 'mingcute:rss-fill',            label: 'Article de blog' },
                    { shown: talk.hasInterviewUrl,     url: talk.getInterviewUrl,   icon: 'mingcute:news-2-fill',         label: 'Interview' },
                    { shown: talk.hasJoindinId,        url: talk.getJoindinUrl,     icon: 'mingcute:message-3-fill',      label: 'Fiche joind.in', rel: 'nofollow' },
                    { shown: talk.hasOpenfeedbackPath, url: talk.getOpenfeedbackUrl, icon: 'mingcute:message-3-fill',     label: 'Fiche openfeedback.io' },
                ]|filter(link => link.shown) %}

                {% if links|length %}
                    <twig:Card:Section title="Ressources">
                        <div class="flex flex-col gap-2">
                            {% for link in links %}
                                <twig:Button variant="secondary" as="a" href="{{ link.url }}" :rel="link.rel ?? false"
                                             class="flex w-full items-center justify-start gap-2">
                                    <twig:ux:icon name="{{ link.icon }}" class="size-4 shrink-0" />
                                    {{ link.label }}
                                </twig:Button>
                            {% endfor %}
                        </div>
                    </twig:Card:Section>
                {% endif %}

                <twig:Card:Section title="Langue">
                    <ul class="flex flex-col gap-2">
                        <li class="flex items-center gap-2 text-sm text-neutre-700">
                            <twig:ux:icon name="mingcute:headphone-fill" class="size-4 shrink-0 text-afup-500" />
                            Audio : {{ talk.getLanguageLabel|lower }}
                        </li>
                        {% if talk.getVideoHasFrSubtitles %}
                            <li class="flex items-center gap-2 text-sm text-neutre-700">
                                <twig:ux:icon name="mingcute:subtitle-fill" class="size-4 shrink-0 text-afup-500" />
                                Sous-titres : français
                            </li>
                        {% endif %}
                        {% if talk.getVideoHasEnSubtitles %}
                            <li class="flex items-center gap-2 text-sm text-neutre-700">
                                <twig:ux:icon name="mingcute:subtitle-fill" class="size-4 shrink-0 text-afup-500" />
                                Sous-titres : anglais
                            </li>
                        {% endif %}
                    </ul>
                </twig:Card:Section>
            </twig:Card>
        </div>

    </div>


    {% if talk.getTweetsHasArray|length > 0 or talk.getBlueskyPostsAsArray|length > 0 %}
        {# Hors du bloc à deux colonnes : les embeds Twitter et Bluesky ont une largeur
           minimale et s'écrasent dans la colonne de gauche. #}
        <div class="container mx-auto px-4 pb-6 sm:px-28 sm:pb-10 flex flex-col gap-10">
            {% if talk.getTweetsHasArray|length > 0 %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Tweets</twig:SectionTitle>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        {% for tweet in talk.getTweetsHasArray %}
                            <blockquote class="twitter-tweet">
                                <a href="{{ tweet }}?ref_src=twsrc%5Etfw">{{ tweet }}</a>
                            </blockquote>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}

            {% if talk.getBlueskyPostsAsArray|length > 0 %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Posts Bluesky</twig:SectionTitle>
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        {% for post in talk.getBlueskyPostsAsArray %}
                            <div>{{ bluesky_oembed(post) }}</div>
                        {% endfor %}
                    </div>
                </section>
            {% endif %}
        </div>
    {% endif %}

    {% if related_talks.previous or related_talks.next or related_talks.sameEvent|length or related_talks.bySpeaker|length %}
        <div class="container mx-auto px-4 pb-6 sm:px-28 sm:pb-10 flex flex-col gap-10">
            {% if related_talks.previous or related_talks.next %}
                <nav aria-label="Dans le planning de l'édition" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    {% if related_talks.previous %}
                        <a href="{{ path('talks_show', {id: related_talks.previous.id, slug: related_talks.previous.slug}) }}"
                           rel="prev"
                           class="group flex items-center gap-3 border-2 border-neutre-300 rounded-2xl p-4 hover:border-afup-300">
                            <twig:ux:icon name="mingcute:arrow-left-fill" class="size-5 shrink-0 text-afup-500" />
                            <span class="flex flex-col min-w-0">
                                <span class="text-sm text-neutre-400">Talk précédent</span>
                                <span class="font-semibold text-afup-800 group-hover:text-afup-500">{{ related_talks.previous.title }}</span>
                            </span>
                        </a>
                    {% endif %}
                    {% if related_talks.next %}
                        <a href="{{ path('talks_show', {id: related_talks.next.id, slug: related_talks.next.slug}) }}"
                           rel="next"
                           class="group flex items-center justify-end gap-3 border-2 border-neutre-300 rounded-2xl p-4 text-right hover:border-afup-300 sm:col-start-2">
                            <span class="flex flex-col min-w-0">
                                <span class="text-sm text-neutre-400">Talk suivant</span>
                                <span class="font-semibold text-afup-800 group-hover:text-afup-500">{{ related_talks.next.title }}</span>
                            </span>
                            <twig:ux:icon name="mingcute:arrow-right-fill" class="size-5 shrink-0 text-afup-500" />
                        </a>
                    {% endif %}
                </nav>
            {% endif %}

            {% if related_talks.sameEvent|length %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Aussi au {{ event.title }}</twig:SectionTitle>
                    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for related in related_talks.sameEvent %}
                            <li>
                                <a href="{{ path('talks_show', {id: related.id, slug: related.slug}) }}" class="group flex flex-col gap-2">
                                    {% if related.hasYoutubeId %}
                                        <img src="https://img.youtube.com/vi/{{ related.youtubeId }}/mqdefault.jpg" alt="" loading="lazy"
                                             class="w-full aspect-video rounded-xl object-cover bg-neutre-200" />
                                    {% else %}
                                        <span class="w-full aspect-video rounded-xl bg-afup-100 flex items-center justify-center text-afup-300">
                                            <twig:ux:icon name="mingcute:presentation-1-fill" class="size-10" />
                                        </span>
                                    {% endif %}
                                    <span class="font-semibold text-afup-800 group-hover:text-afup-500">{{ related.title }}</span>
                                </a>
                            </li>
                        {% endfor %}
                    </ul>
                    <a href="{{ event_url }}" class="self-start text-sm text-afup-500 underline hover:no-underline">Tous les talks du {{ event.title }}</a>
                </section>
            {% endif %}

            {% for speaker_talks in related_talks.bySpeaker %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Autres talks de {{ speaker_talks.speaker.label }}</twig:SectionTitle>
                    <ul class="flex flex-col gap-2">
                        {% for related in speaker_talks.talks %}
                            <li class="flex flex-wrap items-baseline gap-x-2">
                                <a href="{{ path('talks_show', {id: related.talk.id, slug: related.talk.slug}) }}"
                                   class="font-semibold text-afup-800 hover:text-afup-500">{{ related.talk.title }}</a>
                                <span class="text-sm text-neutre-400">{{ related.event.title }}</span>
                            </li>
                        {% endfor %}
                    </ul>
                </section>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {% if talk.getTweetsHasArray|length > 0 %}
        <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
    {% endif %}
    {% if talk.getBlueskyPostsAsArray|length > 0 %}
        <script async src="https://embed.bsky.app/static/embed.js" charset="utf-8"></script>
    {% endif %}

    {% if talk.hasYoutubeId %}
        <script src="https://www.youtube.com/iframe_api"></script>
        <script>
            // Ce bloc est rendu dans le <head> : sans DOMContentLoaded, le DOM n'existe pas encore.
            document.addEventListener('DOMContentLoaded', function () {
                var player = null;

                window.onYouTubeIframeAPIReady = function () {
                    player = new YT.Player('player', { videoId: '{{ talk.youtubeId }}' });
                };

                document.querySelectorAll('.transcript p[data-cue-start]').forEach(function (cue) {
                    cue.addEventListener('click', function () {
                        if (!player || typeof player.seekTo !== 'function') {
                            return;
                        }

                        player.seekTo(parseFloat(cue.dataset.cueStart));
                        document.getElementById('player').scrollIntoView({ behavior: 'smooth', block: 'center' });
                    });
                });
            });
        </script>
    {% endif %}
{% endblock %}
