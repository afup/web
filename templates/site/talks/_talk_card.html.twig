{# Carte d'un talk, la même sur le hub, les pages événement et speaker, et dans les résultats de recherche
   Algolia (htdocs/js/talk/list.js : modifier les deux ensemble).

   Vignette, titre, puis une ligne « Speakers · Événement · Date », chaque partie n'apparaissant que si elle est
   fournie ; ce qui a une page est un lien (couleur AFUP), le reste est du texte (gris) :
   - `speakers` et `speaker_slugs` (slug de la page speaker, par ID de ligne speaker) ;
   - `event` ;
   - `date`, avec l'heure si `date_with_time`.
   Enfin les liens vers les slides et l'article de blog du talk. #}
{% set talk_url = path('talks_show', {id: talk.id, slug: talk.slug}) %}
{% set link_class = 'text-afup-500 hover:underline' %}
{% set resource_class = 'inline-flex items-center gap-1.5 rounded-lg bg-afup-100 px-2 py-1 text-xs font-medium text-afup-500 hover:bg-afup-500 hover:text-white' %}
{% set speakers = speakers|default([]) %}
{% set event = event|default(null) %}
{% set date = date|default(null) %}
<article class="flex flex-col sm:flex-row gap-4 rounded-2xl border-2 border-neutre-300 p-4">
    <a href="{{ talk_url }}" class="shrink-0 w-full sm:w-44" tabindex="-1" aria-hidden="true">
        <img src="{{ talk.hasYoutubeId ? 'https://img.youtube.com/vi/' ~ talk.youtubeId ~ '/hqdefault.jpg' : asset('/images/no_video.jpg') }}"
             alt="" loading="lazy" class="w-full aspect-video rounded-xl object-cover bg-neutre-200" />
    </a>
    <div class="flex flex-col gap-2 grow min-w-0">
        <h3 class="font-titre text-lg leading-snug text-afup-800">
            <a href="{{ talk_url }}" class="hover:underline">{{ talk.title }}</a>
        </h3>
        {% if speakers is not empty or event is not null or date is not null %}
            <p class="text-sm text-neutre-400">
                {%- for speaker in speakers -%}
                    {%- if speaker_slugs|default({})[speaker.id] is defined -%}
                        <a href="{{ path('talks_speaker', {slug: speaker_slugs[speaker.id]}) }}" class="{{ link_class }}">{{ speaker.label }}</a>
                    {%- else -%}
                        {{ speaker.label }}
                    {%- endif -%}
                    {{- not loop.last ? ' et ' -}}
                {%- endfor -%}
                {%- if event is not null -%}
                    {{- speakers is not empty ? ' · ' -}}
                    <a href="{{ path('talks_event', {path: event.path}) }}" class="{{ link_class }}">{{ event.title }}</a>
                {%- endif -%}
                {%- if date is not null -%}
                    {{- speakers is not empty or event is not null ? ' · ' -}}
                    {%- if date_with_time|default(false) -%}
                        <time datetime="{{ date|date('Y-m-d\\TH:i') }}">{{ date|format_datetime('long', 'short') }}</time>
                    {%- else -%}
                        <time datetime="{{ date|date('Y-m-d') }}">{{ date|format_date('long') }}</time>
                    {%- endif -%}
                {%- endif -%}
            </p>
        {% endif %}
        {% if talk.slidesUrl or talk.blogPostUrl %}
            <ul class="flex flex-wrap items-center gap-2 mt-auto">
                {% if talk.blogPostUrl %}
                    <li><a href="{{ talk.blogPostUrl }}" target="_blank" rel="noopener" class="{{ resource_class }}"><twig:ux:icon name="mingcute:rss-fill" class="size-3.5" />Article de blog</a></li>
                {% endif %}
                {% if talk.slidesUrl %}
                    <li><a href="{{ talk.slidesUrl }}" target="_blank" rel="noopener" class="{{ resource_class }}"><twig:ux:icon name="mingcute:presentation-1-fill" class="size-3.5" />Slides</a></li>
                {% endif %}
            </ul>
        {% endif %}
    </div>
</article>
