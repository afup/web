{% extends 'layouts/site.html.twig' %}

{% block title %}Lien invalide - AFUP{% endblock %}

{% block content %}

    <div class="container mx-auto flex flex-col items-center px-4 my-5 gap-4">
        <h1 class="font-titre text-5xl text-afup-800 text-center">Lien invalide</h1>

        <twig:Card class="flex flex-col gap-8 px-6 py-12 sm:px-28 sm:py-12 my-5 sm:mb-10 w-full sm:w-200">

            <twig:Alert type="warning" class="w-full">
                Ce lien n'est plus valide. Il a peut-être expiré, ou déjà servi à changer votre mot de passe.
            </twig:Alert>

            <div class="flex flex-col-reverse sm:flex-row items-center justify-between gap-4 border-t-2 border-neutre-300 pt-5">
                <p class="text-sm text-neutre-700 whitespace-nowrap">
                    <a href="{{ path('app_login') }}" class="text-afup-500 underline hover:no-underline">Retour à la connexion</a>
                </p>
                <twig:Button variant="primary" as="a" href="{{ path('app_password_reset') }}">Demander un nouveau lien</twig:Button>
            </div>

        </twig:Card>
    </div>

{% endblock %}
