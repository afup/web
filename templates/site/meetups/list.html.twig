{% extends 'layouts/site.html.twig' %}
{% set menu_current_feuille_id = constant('Afup\\Site\\Corporate\\Feuille::ID_FEUILLE_ANTENNES') %}

{% block title %}Les meetups des antennes de l'AFUP{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {# `defer` obligatoire : ce bloc est rendu dans le <head>, sans lui instantsearch
       s'exécute avant l'existence de ses conteneurs. #}
    <script defer src="https://cdn.jsdelivr.net/instantsearch.js/1/instantsearch.min.js"></script>
    <script defer src="/js/meetups/list.js"></script>
{% endblock %}

{% block metas %}
    {{ parent() }}
    <meta name="algolia_appid" content="{{ algolia_app_id }}" />
    <meta name="algolia_apikey" content="{{ algolia_api_key }}" />
{% endblock %}

{% block content %}

    <div class="container mx-auto flex flex-col px-4 py-6 gap-6 sm:px-28 sm:py-10 sm:gap-10">

        <div class="flex flex-col gap-5">
            <h1 class="font-titre text-afup-800 text-2xl sm:text-4xl">Meetups des antennes</h1>
            <p class="text-neutre-700">
                Retrouvez ici tous les meetups des antennes de l'AFUP.
            </p>

            {% if source == 'aperophp.net' %}
                <twig:Alert type="warning">
                    aperophp.net évolue et s'adapte aux nouvelles pratiques des antennes : retrouvez désormais
                    l'ensemble des apéros PHP et meetups organisés par les antennes de l'AFUP sur cette page.
                </twig:Alert>
            {% endif %}

            <div id="search-box"></div>
        </div>

        <div class="flex flex-col sm:flex-row gap-5 sm:gap-8 items-start">
            <div id="hits-container" class="grow w-full"></div>

            <div class="w-full sm:w-72 sm:shrink-0">
                <twig:Card class="flex flex-col gap-6">
                    <div id="refinement-is-upcoming"></div>
                    <div id="refinement-office"></div>
                    <div id="refinement-year"></div>
                    <div id="refinement-clear"></div>
                </twig:Card>
            </div>
        </div>

        <nav id="pagination" aria-label="Pagination des meetups" class="mx-auto flex w-full justify-center"></nav>

    </div>

{% endblock %}
