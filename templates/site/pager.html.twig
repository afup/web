{# Pages choisies par AppBundle\Pagination\SeoPagination : toute page est à quelques clics de la première. #}
{% macro page_link(page, current_page, extra_parameters) %}
    <li>
        <twig:Button :variant="page == current_page ? 'tertiary' : 'secondary'"
                     as="a"
                     href="{{ path('news_list', {page: page}|merge(extra_parameters)) }}"
                     aria-label="Page {{ page }}"
                     :aria-current="page == current_page ? 'page' : false"
                     class="flex">
            {{ page }}
        </twig:Button>
    </li>
{% endmacro %}
{% set separator %}<li aria-hidden="true" class="text-neutre-400">…</li>{% endset %}
{% if last_page > 1 %}
<nav class="mx-auto flex w-full justify-center" aria-label="Pagination">
    <ul class="flex flex-row flex-wrap justify-center gap-2 items-center">
        {% if current_page > 1 %}
            <li>
                <twig:Button variant="secondary"
                             as="a"
                             rel="prev"
                             href="{{ path('news_list', {page: current_page - 1}|merge(extra_parameters)) }}"
                             aria-label="Page précédente"
                             class="flex items-center gap-2">
                    <twig:UX:Icon name="fa-solid:angle-left" class="h-4"/>
                </twig:Button>
            </li>
        {% endif %}
        {% for page in pages.before %}{{ _self.page_link(page, current_page, extra_parameters) }}{% endfor %}
        {% if pages.before is not empty %}{{ separator }}{% endif %}
        {% for page in pages.around %}{{ _self.page_link(page, current_page, extra_parameters) }}{% endfor %}
        {% if pages.after is not empty %}{{ separator }}{% endif %}
        {% for page in pages.after %}{{ _self.page_link(page, current_page, extra_parameters) }}{% endfor %}
        {% if current_page < last_page %}
            <li>
                <twig:Button variant="secondary"
                             as="a"
                             rel="next"
                             href="{{ path('news_list', {page: current_page + 1}|merge(extra_parameters)) }}"
                             aria-label="Page suivante"
                             class="flex items-center gap-2">
                    <twig:UX:Icon name="fa-solid:angle-right" class="h-4"/>
                </twig:Button>
            </li>
        {% endif %}
    </ul>
</nav>
{% endif %}
