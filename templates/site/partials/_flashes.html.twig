{#
    Rendu des messages flash, que `layouts/site.html.twig` n'assure pas alors que
    les gabarits legacy le faisaient (`templates/base.html.twig`).
    Le sac `notice` sort en vert faute de variante `info` sur `Alert`.
#}
{% set flashes = { notice: 'success', success: 'success', error: 'error' } %}
{% set messages %}
    {% for bag, type in flashes %}
        {% for message in app.flashes(bag) %}
            <twig:Alert type="{{ type }}">{{ message|nl2br }}</twig:Alert>
        {% endfor %}
    {% endfor %}
{% endset %}

{% if messages|trim is not empty %}
    <div class="container mx-auto flex flex-col px-4 pt-6 gap-4 sm:px-28 sm:pt-10">{{ messages }}</div>
{% endif %}
