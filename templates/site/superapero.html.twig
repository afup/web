{% extends 'layouts/site.html.twig' %}

{% block title %}Super-apéro PHP{% endblock %}

{% block metas %}
    {{ parent() }}
    <meta property="og:title" content="AFUP - Super-apéro PHP" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content="{{ url('superapero') }}" />
    <meta property="og:image" content="{{ absolute_url(asset('images/super_apero_php-300x213.png')) }}" />
    <meta property="og:description" content="Super Apéro PHP, l’apéro avec une cape organisé dans les antennes AFUP" />
    <meta property="og:site_name" content="AFUP" />
{% endblock %}

{% block content %}

    {# En-tête pleine largeur sur le voile bleu nuit des autres pages refondues.
       Le logo « apéro avec une cape » remplace les deux images qui encadraient le H1. #}
    <div class="bg-gradient-to-br from-afup-900 via-afup-800 to-afup-700">
        <div class="container mx-auto px-4 py-12 sm:px-28 sm:py-16 relative isolate flex flex-col items-center text-center gap-6">
            <img src="https://identity.afup.org/assets/apero_php/logo_apero_php.png" alt="" width="120" height="120"
                 class="size-24 sm:size-28 object-contain" />

            <div class="flex flex-col items-center gap-4">
                <h1 class="font-titre font-normal text-3xl sm:text-4xl leading-tight text-white">Super-apéro PHP</h1>
                <p class="font-sans font-normal text-lg text-white/90">Des apéros PHP le même jour dans toutes les antennes !</p>
            </div>

            <p class="font-sans font-normal text-base text-white/90 max-w-3xl">
                Bloquez votre soirée du
                <time datetime="{{ superApero.date|date('Y-m-d') }}" class="font-semibold text-white">{{ superApero.date|format_date(pattern='EEEE d MMMM', locale='fr') }}</time>
                et rendez-vous dans votre antenne locale pour une soirée de conférences et d'échanges, où toute la
                communauté PHP sera invitée à lever son verre pour célébrer le langage !
            </p>
        </div>
    </div>

    <div class="container mx-auto flex flex-col px-4 py-6 gap-6 sm:px-28 sm:py-10 sm:gap-10">
        <div class="flex flex-col gap-5">
            <twig:SectionTitle>Les antennes participantes</twig:SectionTitle>

            {# La grille remplace le découpage manuel en rangées de deux (`loop.index is odd`
               + `col-md-6`) : plus de balises ouvertes/fermées à cheval sur la boucle. #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5 sm:gap-8">
                {% for meetup in superApero.meetups %}
                    <twig:Card class="flex flex-col gap-5 p-6 sm:p-8">
                        <div class="flex flex-row items-center gap-4">
                            <div class="bg-neutre-200 rounded-2xl size-20 shrink-0 flex items-center justify-center">
                                <img src="{{ office_logo(meetup.antenne) }}" alt="" class="w-full h-full object-contain" />
                            </div>
                            <h3 class="font-titre font-bold text-2xl text-afup-800">{{ office_name(meetup.antenne) }}</h3>
                        </div>

                        {% if meetup.description %}
                            <div class="prose prose-sm max-w-none font-sans text-neutre-700">{{ meetup.description|raw }}</div>
                        {% endif %}

                        {# Sans groupe Meetup l'URL d'inscription serait tronquée : on n'affiche
                           alors pas de bouton plutôt qu'un lien cassé. #}
                        {% set meetup_urlname = office_meetup_urlname(meetup.antenne) %}
                        {% if meetup.meetupId and meetup_urlname %}
                            {# `mt-auto` : le bouton reste collé en bas, aligné d'une carte à
                               l'autre quelle que soit la longueur de la description. #}
                            <div class="mt-auto border-t-2 border-neutre-300 pt-5">
                                <twig:Button variant="primary" as="a"
                                             href="https://www.meetup.com/fr-FR/{{ meetup_urlname }}/events/{{ meetup.meetupId }}/"
                                             class="flex w-full px-8 py-3 text-base font-semibold">S'inscrire</twig:Button>
                            </div>
                        {% endif %}
                    </twig:Card>
                {% endfor %}
            </div>
        </div>
    </div>

{% endblock %}
