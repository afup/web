{% extends 'layouts/site.html.twig' %}

{% block metas %}
    {{ parent() }}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "AFUP",
        "alternateName": "Association Française des Utilisateurs de PHP",
        "url": "https://afup.org",
        "logo": "https://afup.org/templates/site/img/logo-afup.svg",
        "description": "L'AFUP, Association Française des Utilisateurs de PHP, est au cœur de la communauté PHP depuis 2000. Elle vise à favoriser l'échange d'expertises et la diffusion des connaissances.",
        "foundingDate": "2000",
        "sameAs": [
            "https://www.linkedin.com/company/afup",
            "https://mastodon.online/@afup",
            "https://bsky.app/profile/afup.org",
            "https://www.instagram.com/afup_php/",
            "https://www.youtube.com/c/afupPHP"
        ]
    }
    </script>
{% endblock %}

{% block content %}
<div class="home-banner bg-afup-800 bg-cover bg-center">
    <div class="container mx-auto flex flex-col gap-5 p-4 sm:py-15 sm:px-0 text-white">
        <h1 class="font-titre text-6xl">
            AFUP : Association Française<br/>des Utilisateurs de PHP
        </h1>

        <p class="text-xl">
            Apéros, rendez-vous et cycle de conférences, l'AFUP est au cœur de la communauté PHP depuis 2000.<br/>
            L'AFUP vise à favoriser l'échange d'expertises et la diffusion des connaissances auprès de la communauté.
        </p>
    </div>
</div>

<div class="container mx-auto p-4 sm:py-10 flex flex-col gap-10">
    <section class="w-full">
        <h1 class="text-afup-800 font-titre text-2xl sm:text-4xl border-b-2 border-neutre-300 pb-3 mb-5 hidden sm:block">
            Actualités
        </h1>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
            <twig:Card class="col-span-2 p-0 flex-col overflow-hidden hidden sm:flex">
                <a href="{{ path('news_display', {'code': articles[0].slug}) }}"
                   class="block bg-cover bg-center grow"
                   style="background-image: url({{ asset('images/article-default-image.svg') }})">
                    {% if articles[0].theme %}
                        <a href="{{ path('news_list', {'news_filters[theme][]': articles[0].theme.value}) }}" class="block absolute mt-5 ml-5 bg-ruby-400 pl-2 pr-4 py-1 rounded-full text-white uppercase flex gap-1 items-center">
                            <twig:UX:Icon name="oui:dot" class="size-6 text-ruby-200" /> {{ articles[0].theme.label }}
                        </a>
                    {% endif %}
                </a>

                <article class="p-5 flex flex-col gap-5">
                    <div class="self-start flex flex-row gap-2 items-center">
                        <div class="bg-afup-100 rounded-xl p-2 flex items-center justify-center">
                            <twig:UX:Icon name="uil:calendar" class="size-5" />
                        </div>

                        <time datetime="{{ articles[0].datePublication|date('Y-m-d') }}"
                              class="font-medium">
                            {{ articles[0].datePublication|format_date('long') }}
                        </time>
                    </div>

                    <a href="{{ path('news_display', {'code': articles[0].slug}) }}"
                       class="font-titre text-3xl">
                        {{ articles[0].titre }}
                    </a>

                    {% if articles[0].chapeau %}
                        <p>{{ articles[0].chapeau|markdown_to_html }}</p>
                    {% endif %}

                    <twig:Button variant="tertiary"
                                 as="a"
                                 href="{{ path('news_display', {'code': articles[0].slug}) }}"
                                 class="self-start flex gap-2">
                        Lire l'article complet <twig:UX:Icon name="mingcute:arrow-right-fill" class="size-5" />
                    </twig:Button>
                </article>
            </twig:Card>

            <twig:Card class="col-span-1">
                <twig:Card:Title size="big">Dernières actualités</twig:Card:Title>

                <div class="flex flex-col gap-6">
                    {% for article in articles %}
                        <article class="flex-col gap-2 {{ loop.first ? 'flex sm:hidden' : 'flex' }}">
                            {% if article.theme %}
                                <a href="{{ path('news_list', {'news_filters[theme][]': article.theme.value}) }}"
                                   class="block uppercase border border-neutre-300 rounded-full w-fit px-2 py-1 text-xs font-bold">
                                    {{ article.theme.label }}
                                </a>
                            {% endif %}

                            <div class="flex flex-row gap-2 items-center">
                                <twig:Time:DayAndMonth :date="article.datePublication" variant="dark" />

                                <a href="{{ path('news_display', {code: article.slug}) }}"
                                   class="text-titre font-light">
                                    {{ article.titre }}
                                </a>
                            </div>
                        </article>
                    {% endfor %}

                    <twig:Button variant="tertiary" as="a" href="{{ path('news_list') }}" class="flex gap-2">
                        Voir toutes les actualités <twig:UX:Icon name="mingcute:arrow-right-fill" class="h-5" />
                    </twig:Button>
                </div>
            </twig:Card>
        </div>
    </section>

    <section class="w-full">
        <h1 class="text-afup-800 font-titre text-2xl sm:text-4xl border-b-2 border-neutre-300 pb-3 mb-5 hidden sm:block">
            {{ currentEvent.title }}
        </h1>

        <div class="flex flex-col sm:grid sm:grid-cols-2">
            <div class="relative isolate bg-cover bg-center grow flex items-center justify-center rounded-t-xl rounded-bl-none sm:rounded-l-xl sm:rounded-tr-none
            before:content-[''] before:absolute before:inset-0 before:bg-afup-800/70 before:-z-10 before:rounded-t-xl before:rounded-bl-none sm:before:rounded-l-xl sm:before:rounded-tr-none"
                 style="background-image: url('{{ asset('images/home-banner.webp') }}')">
                <img src="{{ asset('images/forumphp-2026-vecto-light.svg') }}" class="min-h-30 sm:min-h-60 m-20" alt="Logo {{ currentEvent.title }}" />
            </div>
            <div class="rounded-b-xl rounded-tr-none sm:rounded-r-xl sm:rounded-bl-none p-4 sm:p-10 flex flex-col gap-10 bg-linear-to-b from-afup-700 to-afup-300 text-white">
                <h1 class="font-titre text-4xl">
                    Participez au {{ currentEvent.title }}
                </h1>
                <p>
                    Le rendez-vous incontournable de la communauté PHP en France. Rejoignez-nous les 8 et 9 octobre 2026
                    pour deux jours de conférences, d'ateliers et de networking.
                </p>
                <div class="flex flex-col gap-3">
                    <div class="flex flex-row gap-3 items-center">
                        <div class="border-neutre-200 bg-white/20 border-white/50 border p-3 rounded-xl">
                            <twig:UX:Icon name="uil:calendar" class="size-6" />
                        </div>
                        <h2 class="font-titre text-xl sm:text-3xl">8 &amp; 9 octobre 2026</h2>
                    </div>

                    <div class="flex flex-row gap-3 items-center">
                        <div class="border-neutre-200 bg-white/20 border-white/50 border p-3 rounded-xl">
                            <twig:UX:Icon name="akar-icons:location" class="size-6" />
                        </div>
                        <h2 class="font-titre text-sm sm:text-lg leading-5">
                            Hotel New York - The Art of Marvel,<br/>
                            Disneyland Paris
                        </h2>
                    </div>
                </div>
                <div class="flex flex-col sm:flex-row gap-5">
                    <twig:Button variant="secondary"
                                 class="flex gap-2"
                                 as="a"
                                 href="{{ path('ticket', {eventSlug: currentEvent.path}) }}">
                        Réserver ma place <twig:UX:Icon name="mingcute:arrow-right-fill" class="size-5" />
                    </twig:Button>

                    <twig:Button variant="secondary-outline"
                                 class="flex gap-2"
                                 as="a"
                                 href="https://event.afup.org/forum-php-2026/programme/">
                        Voir le programme
                    </twig:Button>
                </div>
            </div>
        </div>
    </section>

    <section class="flex flex-col sm:grid grid-flow-col grid-cols-2 gap-10">
        <twig:Card class="row-span-1">
            <twig:Card:Title size="big">Dans les antennes</twig:Card:Title>
            <twig:Card:Subtitle>Meetups à travers la France</twig:Card:Subtitle>

            <div class="flex flex-col gap-6">
                {% for meetup in meetups %}
                    <a href="https://www.meetup.com/fr-FR/{{ office_meetup_urlname(meetup.codeAntenne) }}/events/{{ meetup.id }}/">
                        <article class="flex flex-row gap-2 items-center">
                            <twig:Time:DayAndMonth :date="meetup.date" variant="light" />

                            <div>
                                <h2 class="flex items-center gap-1 uppercase font-bold text-sm">
                                    <twig:UX:Icon name="akar-icons:location" class="size-4" /> {{ office_name(meetup.codeAntenne) }}
                                </h2>
                                <h1 class="text-titre font-light">
                                    {{ meetup.titre }}
                                </h1>
                            </div>
                        </article>
                    </a>
                {% endfor %}

                <twig:Button variant="tertiary" as="a" href="{{ path('meetups_list') }}" class="flex gap-2">
                    Voir touts les meetups <twig:UX:Icon name="mingcute:arrow-right-fill" class="h-5" />
                </twig:Button>
            </div>
        </twig:Card>

        <twig:Card class="row-span-1 flex flex-col">
            <twig:Card:Title size="big">La veille de l'AFUP</twig:Card:Title>
            <twig:Card:Subtitle>Newsletter technique pour les devs PHP</twig:Card:Subtitle>

            <div class="grow p-0 flex flex-col gap-5">
                <img src="{{ asset('images/veille.png') }}" alt="Veille" />

                <p class="grow">
                    Membres AFUP, profitez du meilleur de PHP et soyez à jour sur son actualité.<br/>
                    <br/>
                    Abonnez-vous à notre newsletter La Veille de l'AFUP. Progrès du langage, conseils de spécialistes,
                    nouvelles versions, l'AFUP fait la veille pour vous et vous l'envoie par mail.
                </p>

                <twig:Button variant="tertiary" as="a" href="{{ path('techletter') }}" class="flex gap-2">
                    En savoir plus <twig:UX:Icon name="mingcute:arrow-right-fill" class="h-5" />
                </twig:Button>
            </div>
        </twig:Card>
    </section>
</div>
{% endblock %}
