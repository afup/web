{% if google_analytics_enabled %}
    <link rel="stylesheet" href="{{ asset('npm-asset/tarteaucitronjs/css/tarteaucitron.min.css') }}">
    <script src="{{ asset('npm-asset/tarteaucitronjs/tarteaucitron.min.js') }}" defer></script>
    <script src="{{ asset('npm-asset/tarteaucitronjs/lang/tarteaucitron.fr.min.js') }}" defer></script>
    <script src="{{ asset('npm-asset/tarteaucitronjs/tarteaucitron.services.min.js') }}" defer></script>
    <script src="{{ asset('tarteaucitron/config.js') }}" defer></script>

    <script type="text/javascript">
        {# Les scripts defer s'exécutent avant DOMContentLoaded, pas avant ce script inline #}
        document.addEventListener('DOMContentLoaded', function () {
            tarteaucitron.user.gtagUa = '{{ google_analytics_id }}';
            tarteaucitron.user.gtagMore = function () {
                {% block google_analytics_gtag %}{% endblock %}
            };
            (tarteaucitron.job = tarteaucitron.job || []).push('gtag');
        });
    </script>
{% endif %}
