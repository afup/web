{% extends 'base.html.twig' %}

{% block title %}{{ 'Appel à conférenciers'|trans }}{% if event is defined %} – {{ event.title }}{% endif %} – AFUP{% endblock %}

{# Une page enfant désindexe avec `{% set noindex = true %}` : pas de canonical vers une page noindex. #}
{% block metas %}
    {{ parent() }}
    {% if noindex|default(false) %}
        <meta name="robots" content="noindex, follow">
    {% endif %}
{% endblock %}

{% block canonical %}
    {% if not noindex|default(false) %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('/css/grid.css') }}">
    <link rel="stylesheet" href="{{ asset('/css/buttons.css') }}">
    <link rel="stylesheet" href="{{ asset('/css/vote.css') }}?1">
    <link rel="stylesheet" href="{{ asset('templates/site/css/global-menu.css') }}" media="all" />
{% endblock %}

{% block header %}
    {% include 'event/menu.html.twig' %}
{% endblock %}
