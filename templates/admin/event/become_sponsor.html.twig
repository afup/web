{% extends 'admin/base_with_header.html.twig' %}

{% form_theme form 'form_theme_admin.html.twig' %}

{% block content %}
    <h2>Page devenir sponsor</h2>

    <div class="ui menu">
        <a href="{{ path('become_sponsor_generic') }}" class="item" target="_blank">
            <i class="icon external alternate"></i>
            Voir la page publique
        </a>
    </div>

    {{ form_start(form, {'attr': {novalidate: true}}) }}
    {{ form_errors(form) }}
    <div class="ui segment">
        <h2 class="ui header">Mode</h2>
        <div class="ui clearing divider"></div>
        <div class="ui form">
            {{ form_row(form.mode) }}
        </div>
    </div>

    <div class="ui segment">
        <h2 class="ui header">Page sans évènement</h2>
        <div class="ui clearing divider"></div>
        <div class="ui form">
            {% for language, field in {fr: 'textFr', en: 'textEn'} %}
                <div class="inline fields ui grid">
                    {{ form_label(form[field]) }}
                    <div class="field nine wide column">
                        <div style="width: 100%">
                            {{ form_errors(form[field]) }}
                            {{ form_widget(form[field]) }}
                        </div>
                    </div>
                </div>

                {{ form_row(form['sponsor_file_' ~ language]) }}
                {% if sponsorship_file_paths[language] %}
                    <div class="inline fields ui grid">
                        <div class="three wide column right aligned"></div>
                        <div class="field nine wide column">
                            <a href="{{ sponsorship_file_paths[language] }}" target="_blank">Voir le dossier de sponsoring ({{ language|upper }})</a>
                        </div>
                    </div>
                {% endif %}
            {% endfor %}
        </div>
    </div>

    <div class="ui form">
        <div class="inline fields ui grid">
            <div class="three wide column"></div>
            <div class="field nine wide column">
                <button type="submit" class="ui primary button">Enregistrer</button>
            </div>
        </div>
    </div>
    {{ form_end(form) }}
{% endblock %}
