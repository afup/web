{% extends 'layouts/member.html.twig' %}
{% form_theme form 'form_themes/tailwind.html.twig' %}

{% block title %}Assemblée générale - Espace membre{% endblock %}

{% block page_body %}

    <div class="container mx-auto flex flex-col px-4 py-6 gap-6 sm:px-28 sm:py-10 sm:gap-10">

        <h1 class="font-titre text-afup-800 text-2xl sm:text-4xl">Assemblée générale</h1>

        {% if general_meeting_planned %}

            {% if question %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Mon vote lors de l'assemblée générale</twig:SectionTitle>

                    <twig:Card class="flex flex-col gap-5">
                        <p class="font-titre text-xl text-afup-800">{{ question.texte }}</p>

                        {% if not vote_for_current_question %}
                            <div class="flex flex-col sm:flex-row gap-3">
                                {% for voteValeur in vote_valeurs %}
                                    <twig:Button as="a" variant="primary" class="flex grow px-8 py-3 text-base"
                                                 href="{{ url('member_general_meeting_vote', {questionId: question.id, vote: voteValeur.value}) }}">{{ voteValeur.label() }}</twig:Button>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-neutre-700">Votre vote : <span class="font-semibold text-afup-800">{{ vote_for_current_question.getValueLabel }}</span></p>
                        {% endif %}
                    </twig:Card>
                </section>
            {% endif %}

            {% if question_results|length > 0 %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Résultats des votes de l'Assemblée Générale du {{ latest_date|date('d/m/Y') }}</twig:SectionTitle>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left">
                            <thead>
                                <tr class="border-b-2 border-neutre-300 text-sm uppercase text-neutre-700">
                                    <th class="py-2 pr-4 font-medium">Vote</th>
                                    <th class="py-2 pr-4 font-medium text-right">Oui</th>
                                    <th class="py-2 pr-4 font-medium text-right">Non</th>
                                    <th class="py-2 font-medium text-right">Abstention</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for question_result in question_results %}
                                    <tr class="border-b border-neutre-300 text-neutre-700">
                                        <td class="py-3 pr-4">{{ question_result.question.texte }}</td>
                                        <td class="py-3 pr-4 text-right">{{ question_result.count_oui }}</td>
                                        <td class="py-3 pr-4 text-right">{{ question_result.count_non }}</td>
                                        <td class="py-3 text-right">{{ question_result.count_abstention }}</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </section>
            {% endif %}

            <section class="flex flex-col gap-4">
                <twig:SectionTitle>Ma participation à l'Assemblée Générale du {{ latest_date|date('d/m/Y') }}</twig:SectionTitle>

                {{ form_start(form) }}
                <twig:Card class="flex flex-col gap-5 px-6 py-8 sm:px-10 sm:py-10">
                    <p class="text-sm text-neutre-400">*&nbsp;Indique un champ obligatoire</p>

                    {% for key, presenceItem in form.presence.children %}
                        <div>
                            {{ form_label(presenceItem) }}
                            {{ form_widget(presenceItem) }}
                        </div>
                        {% if presenceItem.vars.value == '2' %}
                            {{ form_errors(form.id_personne_avec_pouvoir) }}
                            <div id="pouvoir">
                                {{ form_label(form.id_personne_avec_pouvoir) }}
                                {{ form_widget(form.id_personne_avec_pouvoir) }}
                            </div>
                        {% endif %}
                    {% endfor %}

                    <div class="flex justify-end border-t-2 border-neutre-300 pt-5">
                        {{ form_widget(form.save) }}
                    </div>
                </twig:Card>
                {{ form_end(form) }}

                {# Script laissé dans le corps de page et non dans `javascripts` : ce bloc est rendu
                   dans le <head>, où #pouvoir n'existe pas encore. Ici il s'exécute après le formulaire. #}
                <script>
                    const ABSENCE = '2';
                    const hasError = {{ form.children.id_personne_avec_pouvoir.vars.errors|length >= 1 ? 'true' : 'false' }};

                    const pouvoirElement = document.getElementById('pouvoir');
                    if (!hasError) {
                        pouvoirElement.classList.add('sr-only');
                    }

                    const presencesElement = document.getElementsByName('form[presence]');
                    presencesElement.forEach(function (presenceElement) {
                        presenceElement.addEventListener('change', (event) => {
                            if (event.target.value === ABSENCE) {
                                pouvoirElement.classList.remove('sr-only');
                            } else {
                                pouvoirElement.classList.add('sr-only');
                            }
                        });
                        if (presenceElement.value === ABSENCE &&  presenceElement.hasAttribute('checked')) {
                            pouvoirElement.classList.remove('sr-only');
                        }
                    });
                </script>
            </section>

            {% if personnes_avec_pouvoir %}
                <section class="flex flex-col gap-4">
                    <twig:SectionTitle>Vos pouvoirs</twig:SectionTitle>
                    <p class="text-neutre-700">Ces personnes vous ont donné leur pouvoir :</p>
                    <ul class="list-disc pl-5 text-neutre-700">
                        {% for personne_avec_pouvoir in personnes_avec_pouvoir %}
                            <li>{{ personne_avec_pouvoir.lastname }} {{ personne_avec_pouvoir.firstname }}</li>
                        {% endfor %}
                    </ul>
                </section>
            {% endif %}

            {% if last_general_meeting_description %}
                <div class="prose max-w-none">{{ last_general_meeting_description|markdown }}</div>
            {% endif %}

        {% endif %}

        <section class="flex flex-col gap-4">
            <twig:SectionTitle>Comptes rendus des assemblées générales</twig:SectionTitle>

            {% if app.user.hasRole('ROLE_MEMBER_EXPIRED') %}
                <p class="text-neutre-700">Les comptes rendus ne sont accessibles qu'aux membres à jour de cotisation.</p>
            {% else %}
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="border-b-2 border-neutre-300 text-sm uppercase text-neutre-700">
                                <th class="py-2 pr-4 font-medium">Date</th>
                                <th class="py-2 pr-4 font-medium">Nom</th>
                                <th class="py-2 font-medium">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for report in reports %}
                                <tr class="border-b border-neutre-300 text-neutre-700">
                                    <td class="py-3 pr-4 whitespace-nowrap">{{ report.date|date('d/m/Y') }}</td>
                                    <td class="py-3 pr-4">{{ report.label }}</td>
                                    <td class="py-3">
                                        <twig:Button as="a" variant="secondary" class="flex shrink-0"
                                                     href="{{ path('member_general_meeting_reports_download', {filename: report.filename}) }}">Télécharger</twig:Button>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% endif %}
        </section>

    </div>

{% endblock %}
