{% extends 'admin/base_with_header.html.twig' %}

{% form_theme form 'form_theme_admin.html.twig' %}

{% block content %}
    <h2>Modifier un conférencier pour le {{ eventTitle }}</h2>
    <div class="ui segment">
        <h2 class="ui header">Conférencier</h2>
        <div class="ui clearing divider"></div>
        {{ form_start(form) }}
        <div class="ui form">
            {{ form_row(form.genre) }}
            {{ form_row(form.firstname) }}
            {{ form_row(form.lastname) }}
            {{ form_row(form.email) }}
            {{ form_row(form.phone_number) }}
            {{ form_row(form.company) }}
            {{ form_row(form.locality) }}
            {{ form_row(form.biography) }}
            {{ form_row(form.twitter) }}
            {{ form_row(form.mastodon) }}
            {{ form_row(form.linkedin) }}
            {{ form_row(form.bluesky) }}
            {{ form_row(form.referent_person) }}
            {{ form_row(form.referent_person_email) }}
            {{ form_row(form.photoFile) }}
            {{ form_row(form.github_user) }}
            {% if photo %}
                <div class="inline fields ui grid">
                    <div class="three wide column"></div>
                    <div class="nine wide column">
                        <img src="{{ asset(photo) }}" alt="Photo"/>
                    </div>
                </div>
            {% endif %}

            {% if originalPhoto %}
                <div class="inline fields ui grid">
                    <div class="three wide column"></div>
                    <div class="nine wide column">
                        <a href="{{ asset(originalPhoto) }}" target="_blank">Voir la photo originale</a>
                    </div>
                </div>
            {% endif %}

            <div class="inline fields ui grid">
                <div class="three wide column"></div>
                <div class="field nine wide column">
                    {{ form_row(form.save, {attr: {class: "ui primary button"}}) }}
                </div>
            </div>
        </div>
        {{ form_end(form) }}
    </div>

    <div class="ui segment" id="speaker-person">
        <h2 class="ui header">Personne</h2>
        <div class="ui clearing divider"></div>
        {% if person %}
            <p>
                Fiche rattachée à la personne
                <a href="{{ path('admin_speaker_person', {id: person.id}) }}">{{ person.slug }}</a>.
            </p>
        {% else %}
            <p>Cette fiche n'est rattachée à aucune personne.</p>
            <form method="post" action="{{ path('admin_speaker_person_create') }}" style="display: inline">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_speaker_person') }}">
                <input type="hidden" name="speakerId" value="{{ speakerId }}">
                <input type="submit" value="Créer la personne" class="ui button">
            </form>
            <h3 class="ui header">Rattacher à la personne…</h3>
            <form method="GET" class="ui form">
                <input type="hidden" name="id" value="{{ speakerId }}"/>
                <div class="inline fields">
                    <div class="field">
                        <label for="speaker_person_q">Nom, prénom, email ou société</label>
                        <input type="text" id="speaker_person_q" name="personQuery" value="{{ personSearch }}">
                    </div>
                    <div class="field">
                        <input type="submit" value="Rechercher" class="ui button">
                    </div>
                </div>
            </form>
            {% if personCandidates is not empty %}
                <table class="ui table striped compact celled">
                    <tbody>
                    {% for candidate in personCandidates %}
                        <tr>
                            <td>{{ candidate.personSlug }}</td>
                            <td>{{ candidate.lastname }} {{ candidate.firstname }}</td>
                            <td>{{ candidate.lastEventTitle }}</td>
                            <td>{{ candidate.eventCount }} édition(s)</td>
                            <td style="text-align: right">
                                <form method="post" action="{{ path('admin_speaker_person_attach') }}" style="display: inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('admin_speaker_person') }}">
                                    <input type="hidden" name="speakerId" value="{{ speakerId }}">
                                    <input type="hidden" name="personId" value="{{ candidate.personId }}">
                                    <input type="submit" value="Rattacher" class="compact ui button">
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            {% elseif personSearch is not empty %}
                <p>Aucune personne trouvée.</p>
            {% endif %}
        {% endif %}
    </div>

    <div class="ui segment">
        <h2 class="ui header">Gravatar (si besoin)</h2>
        <div class="ui clearing divider"></div>
        <img src="{{ gravatar }}" alt="Gravatar"/><br/>
        <a href="{{ path('admin_speaker_link_gravatar', {id: speakerId}) }}">Associer à ce conférencier</a>
    </div>
    <div class="ui segment">
        <h2 class="ui header">Conférences</h2>
        <div class="ui clearing divider"></div>
        <div class="ui list">
            {% for talk in talks %}
                <div class="item">
                    <i class="book icon"></i>
                    <div class="content">
                        <a href="{{ url('admin_talk_edit', {id: talk.id}) }}">
                            {{ talk.title }}
                        </a>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
