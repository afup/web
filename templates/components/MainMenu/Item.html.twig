{# @prop variant 'default'|'active' Le type d'entrée #}
{# @block content Label du menu #}
{%- props variant = 'default' -%}
{%- set style = html_cva(
    base: "p-4 font-inter whitespace-nowrap",
    variants: {
        variant: {
            default: 'hover:text-black hover:bg-white',
            active: 'text-black bg-white',
        },
    },
) -%}
<a {{ attributes }} class="{{ style.apply({variant})|tailwind_merge }}">{%- block content %}{% endblock -%}</a>
